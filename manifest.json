{
  "manifest_version": 3,
  "name": "StreamingCommunity Popup Blocker",
  "version": "1.0.0",
  "description": "Blocca l'apertura di tab pubblicitarie sul dominio configurato.",
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SC Popup Blocker"
  }
}
